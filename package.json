{
  "name": "devotion",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "npm run dev --workspace @devotion/web",
    "dev:mobile": "npm run start --workspace @devotion/mobile",
    "dev:backend": "npm run dev --workspace @devotion/backend",
    "build": "npm run build --workspace @devotion/web",
    "start": "npm run start --workspace @devotion/web",
    "lint": "eslint",
    "test": "vitest run",
    "check": "npm run lint && npm run build"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^20",
    "convex": "^1.43.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
