{
  "name": "LICNO",
  "slug": "licno",
  "branch": "licno-run",
  "owner": "Jovan",
  "lang": "sr",
  "defaultModel": "claude-opus-5-5",
  "planDoc": "docs/LICNO-PLAN.md",
  "progressDoc": "docs/LICNO-PROGRESS.md",
  "plansDir": "docs/licno/planovi",
  "screenshotsDir": "docs/licno/snimci",
  "gates": [
    {"name": "codegen", "cmd": "npx convex codegen", "when": "changed:packages/backend/convex/", "timeoutMin": 15},
    {"name": "tsc-backend", "cmd": "npx tsc -p packages/backend/convex/tsconfig.json --noEmit", "timeoutMin": 15},
    {"name": "tsc-web", "cmd": "npx tsc -p apps/web/tsconfig.json --noEmit", "timeoutMin": 15},
    {"name": "tsc-mobile", "cmd": "node .nocni-run/licno/alati/expo-rute.cjs && npx tsc -p apps/mobile/tsconfig.json --noEmit", "timeoutMin": 20},
    {"name": "lint", "cmd": "npx eslint --ignore-pattern \".nocni-run/**\" --ignore-pattern \".playwright-mcp/**\"", "timeoutMin": 20},
    {"name": "test", "cmd": "npx vitest run --no-file-parallelism", "kind": "vitest", "timeoutMin": 40},
    {"name": "build", "cmd": "npm run build", "timeoutMin": 30, "agent": false}
  ],
  "maxFixAttempts": 2,
  "budgetUsd": 0,
  "deny": [
    "Bash(npx convex deploy:*)",
    "Bash(npx convex env:*)",
    "Bash(npx convex run:*)",
    "Bash(npx convex import:*)",
    "Bash(npx convex export:*)",
    "Bash(vercel:*)",
    "Bash(npx vercel:*)",
    "Bash(eas:*)",
    "Bash(npx eas:*)",
    "Bash(npx eas-cli:*)",
    "Bash(npx expo start:*)",
    "Bash(npx expo prebuild:*)",
    "Bash(npx expo run:*)",
    "Bash(npm run android:*)",
    "Bash(npm run ios:*)"
  ],
  "commitExclude": [".nocni-run/licno/cuvar.json"],
  "ownPaths": ["docs/licno"],
  "mcp": {"playwright": true, "playwrightPackage": "@playwright/mcp@0.0.83"},
  "env": {},
  "devPorts": [3000, 3001, 3002, 3003, 8081, 19006],
  "devProcessPattern": "(next|vite|nuxt|astro|remix|convex|webpack|turbo|nodemon|tsx|wrangler|expo)[^ ]*[\"\\s]+(dev|serve|start|watch|preview)|next[\\\\/]dist[\\\\/]server|vite[\\\\/]bin|expo[\\\\/]bin|@expo[\\\\/]cli",
  "commitTrailer": "Co-Authored-By: Claude <noreply@anthropic.com>"
}
