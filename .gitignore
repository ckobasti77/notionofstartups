# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
apps/web/build/

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Izuzetak: mobilni .env.example je bezvredan šablon (samo prazni ključevi) i mora
# da se prati — bez njega na novoj mašini niko ne zna da EXPO_PUBLIC_WEB_URL postoji,
# a bez njega kanvas WebView ne radi. Negacija cilja SAMO .example, ne .env.local.
!apps/mobile/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
