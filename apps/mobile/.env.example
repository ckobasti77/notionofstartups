# Isti convex.cloud URL kao apps/web/.env.local (NEXT_PUBLIC_CONVEX_URL).
# Prefiks EXPO_PUBLIC_ je obavezan da promenljiva stigne do klijentskog koda.
EXPO_PUBLIC_CONVEX_URL=

# Osnovni URL web aplikacije (gde je hostovana /embed ruta) — koristi mobilni
# canvas WebView (M4.3). U dev-u to je http://<LAN-IP>:3000 (ne localhost, jer
# telefon ne vidi localhost host mašine); u produkciji Vercel URL.
EXPO_PUBLIC_WEB_URL=
